// From spike-html-apps-tooling (d77877b): tsconfig.json.
// Adapted from spike-html-apps-foundation (9c15b8d): tsconfig.json, on node.
// The build, src/ into dist/, each module's .js and .d.ts; mise run types checks it with --noEmit.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2025"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": false
  },
  "include": ["src"]
}

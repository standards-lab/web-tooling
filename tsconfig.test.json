// From spike-html-apps-tooling (d77877b): tsconfig.test.json.
// Adapted from spike-html-apps-foundation (7e5d6c2): tsconfig.test.json, with checkJs.
// The type check of the suite, mise run types:test: the tests, their helpers, the fixture stub, and
// the lint's config, against dist/ as a consumer's code is.
// See docs/development.md
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "rootDir": "."
  },
  "include": ["test/**/*.ts", "test/browser/fixtures/screenshots/stub.js", "eslint.config.js"]
}
